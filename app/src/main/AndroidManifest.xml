<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is used ONLY for first-run model download, (optional) podcast RSS, and the
         once/day GitHub release check. The transcription + summarization pipeline is fully offline
         once models are present. F-Droid: this combination earns no anti-feature on its own, but the
         optional podcast/YouTube features are gated behind a build flag (see flavors / SPIKE.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- In-app update: download the signed release APK and hand it to the system installer
         (user confirms; same keystore => in-place update). Note: this is an anti-feature on the
         official f-droid.org repo (Route A) — fine for the self-hosted repo + GitHub APKs. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keep the CPU awake for the duration of a run so transcription/summarization don't stall
         when the screen turns off (battery-aggressive OEMs otherwise doze the SoC). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Let the user grant a Doze/battery-optimization exemption so screen-off runs aren't frozen.
         Portable across OEMs (one system dialog). On the official f-droid.org repo this is flagged as
         an anti-feature (like REQUEST_INSTALL_PACKAGES above) — fine for the self-hosted repo. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- Live "transcribe while recording": mic capture in a foreground service. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- READ_MEDIA_AUDIO (API 33+) for picking local audio; legacy READ_EXTERNAL_STORAGE below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:name=".VoxSumApplication"
        android:allowBackup="true"
        android:largeHeap="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:supportsRtl="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.VoxSum"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- "Share to VoxSum": receive an audio/video file from any app (LINE / WhatsApp voice
                 notes, call recorders, Gmail attachments, browsers…). Receiving a file to transcribe
                 locally is the opposite of an upload — fully on-device, no account. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- "Open with VoxSum" from a file manager / browser download. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync|microphone" />

        <!-- Serves the downloaded update APK to the system installer (cache/updates only). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
