<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET is used ONLY for first-run model download and (optional) podcast RSS.
         The transcription + summarization pipeline is fully offline once models are present.
         F-Droid: this combination earns no anti-feature on its own, but the optional
         podcast/YouTube features are gated behind a build flag (see flavors / SPIKE.md). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- READ_MEDIA_AUDIO (API 33+) for picking local audio; legacy READ_EXTERNAL_STORAGE below. -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:largeHeap="true"
        android:label="VoxSum"
        android:supportsRtl="true"
        android:theme="@style/Theme.VoxSum"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.TranscriptionService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
